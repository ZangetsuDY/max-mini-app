# =========================================================
# TIMEWEB CLOUD / APP PLATFORM
# Не коммитьте этот файл с настоящими значениями.
# Добавляйте значения в интерфейсе Timeweb Cloud -> Переменные.
# =========================================================

NODE_ENV=production

# MAX
MAX_BOT_TOKEN=

# Общий чат «СК-11 OMS • Аварийные отключения»
OUTAGES_CHAT_ID=

# Отдельный чат «СК-11 OMS • Плановые отключения»
PLANNED_OUTAGES_CHAT_ID=
# Необязательно. Если не задано, используется OUTAGES_CACHE_SECONDS / DISPATCHER_CACHE_SECONDS.
# PLANNED_OUTAGES_CACHE_SECONDS=10
# Можно задать отдельный кэш; если не задан, используется DISPATCHER_CACHE_SECONDS
# OUTAGES_CACHE_SECONDS=10

# Чат со СК-11
DISPATCHER_REQUESTS_CHAT_ID=
# Чат со СК-11 • Наряды / допуски
DISPATCHER_WORKORDERS_CHAT_ID=
DISPATCHER_CACHE_SECONDS=10

# Авторизация
AUTH_SECRET=
APP_USERS_JSON=[]

# Старые MAX_HISTORY_PAGES / MAX_LOOKBACK_DAYS для нового аварийного
# мониторинга больше не требуются: берётся последняя сводка из одного чата.

# Redis / Upstash.
# Достаточно одной пары.
#
# Вариант 1 — если переносите значения,
# которые Vercel создал как KV_*:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Вариант 2:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# PORT вручную обычно задавать не нужно:
# Timeweb App Platform передаст свой порт окружением.
