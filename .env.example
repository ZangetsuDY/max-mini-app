# MAX
MAX_BOT_TOKEN=YOUR_MAX_BOT_TOKEN

# Один общий чат с сообщениями:
# "СК-11 OMS • Аварийные отключения"
OUTAGES_CHAT_ID=YOUR_OUTAGES_CHAT_ID
# Необязательно. Если не задано, используется DISPATCHER_CACHE_SECONDS.
# OUTAGES_CACHE_SECONDS=10

# Чат MAX с периодическими сообщениями:
# "СК-11 — счётчик заявок РЭС"
DISPATCHER_REQUESTS_CHAT_ID=YOUR_SK11_CHAT_ID

# Чат MAX с сообщениями:
# "СК-11 • Наряды / допуски"
DISPATCHER_WORKORDERS_CHAT_ID=YOUR_WORKORDERS_CHAT_ID

# Короткий backend-кэш данных СК-11.
DISPATCHER_CACHE_SECONDS=10

# Авторизация
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_USERS_JSON=[{"username":"ivanov","fullName":"Иванов Иван Иванович","salt":"...","passwordHash":"...","iterations":210000}]

# APP_USERS_JSON теперь поддерживает поле "isDispatcher": true/false


# Постоянное runtime-хранилище для:
# - режима системы
# - online пользователей
# - истории последнего входа/сеанса
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Пользователь-разработчик в APP_USERS_JSON:
# "isDeveloper": true
